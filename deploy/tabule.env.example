# Copie para /etc/tabule/tabule.env (dono root, grupo tabule, modo 640) e preencha.
TABULE_ALLOWED_ACCOUNT_IDS=9
TABULE_CHATWOOT_BASE_URL=https://omni.maisa.educa.dev.br
TABULE_PUBLIC_BASE_URL=https://omni.maisa.educa.dev.br
TABULE_OPENAI_API_KEY=
TABULE_OPENAI_MODEL=gpt-6-luna
# Modelo de texto usado por `tabule describe` (padrão: o mesmo de TABULE_OPENAI_MODEL)
#TABULE_OPENAI_DESCRIBE_MODEL=
TABULE_ACCOUNTS_DIR=/etc/tabule/accounts
TABULE_DB_PATH=/var/lib/tabule/tabule.db
TABULE_TIMEZONE=America/Sao_Paulo
TABULE_HOST=127.0.0.1
TABULE_PORT=8088
TABULE_RESOLUTION_DELAY_SECONDS=60
TABULE_RECONCILE_INTERVAL_SECONDS=900
TABULE_RECONCILE_PAGES=4
TABULE_MAX_TRANSCRIPT_CHARS=40000
TABULE_LOG_LEVEL=INFO

# Um par por conta permitida. O id precisa estar em TABULE_ALLOWED_ACCOUNT_IDS.
TABULE_ACCOUNT_9_API_TOKEN=
TABULE_ACCOUNT_9_WEBHOOK_SECRET=
